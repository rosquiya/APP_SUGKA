AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-document-intelligence-key
GEMINI_API_KEY=your-gemini-api-key
# Modelo de Gemini a usar (opcional). Cambialo aca si Google retira
# gemini-3.6-flash mas adelante, sin tener que tocar el codigo.
GEMINI_MODEL=gemini-3.6-flash

# Respaldo automatico para la categorizacion de informes de campo: si Gemini
# falla o no esta configurado, se usa OpenAI. OPENAI_MODEL es opcional
# (por defecto gpt-4.1-mini).
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Contrasenas de los usuarios semilla (solo para desarrollo local).
# En Render estas variables se generan automaticamente y de forma aleatoria
# (ver render.yaml, generateValue: true) - no hace falta definirlas ahi.
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_ESPECIALISTA_PASSWORD=cambia-esta-clave

# Dominio(s) del frontend permitidos por CORS, separados por coma.
# "*" (por defecto) esta bien para desarrollo local y para el despliegue
# monolitico (frontend+backend en el mismo servicio).
ALLOWED_ORIGINS=*

# Horas de validez de una sesion de login antes de expirar.
SESSION_TTL_HOURS=12
